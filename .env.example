# Copy to .env on the server. Never commit .env.
POSTGRES_DB=shoppinghelper
POSTGRES_USER=shoppinghelper
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Generate e.g.: openssl rand -base64 48
JWT_KEY=change-this-to-a-random-secret-at-least-32-characters-long

# API is intentionally bound to localhost so an existing Caddy/Nginx/Traefik can expose HTTPS.
SHOPPINGHELPER_BIND=127.0.0.1
SHOPPINGHELPER_PORT=5180

# Official/current daily price-data URL. CSV, JSON and ZIP containing CSV/JSON are supported.
# Leave empty until a stable/allowed source URL is configured.
GVH_DAILY_DATA_URL=
