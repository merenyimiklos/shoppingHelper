# Copy to .env on the server. Never commit .env.
POSTGRES_DB=shoppinghelper
POSTGRES_USER=shoppinghelper
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Generate e.g.: openssl rand -base64 48
JWT_KEY=change-this-to-a-random-secret-at-least-32-characters-long

# API is intentionally bound to localhost so Tailscale Serve / Caddy / Nginx can expose HTTPS.
SHOPPINGHELPER_BIND=127.0.0.1
SHOPPINGHELPER_PORT=5180

# Optional official/current daily price-data URL. CSV, JSON, XLSX and ZIP are supported.
# Leave empty if you only want the on-demand public Árfigyelő lookup.
GVH_DAILY_DATA_URL=

# On-demand lookup against the public GVH Árfigyelő pages.
# Disable this if the public site structure changes or if you only want imported data.
GVH_LIVE_SEARCH_ENABLED=true
GVH_BASE_URL=https://arfigyelo.gvh.hu
